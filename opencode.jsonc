{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "pr_review": {
      "mode": "primary",
      "permission": {
        "doom_loop": "deny",
        "external_directory": "deny",
        "edit": "deny",
        "lsp": "deny",
        "question": "deny"
      }
    },
    "explore": {
      "permission": {
        "doom_loop": "deny",
        "external_directory": "deny",
        "edit": "deny",
        "lsp": "deny",
        "question": "deny"
      }
    },
    "general": {
      "permission": {
        "doom_loop": "deny",
        "external_directory": "deny",
        "lsp": "deny",
        "question": "deny"
      }
    },
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 120000
  },
  "formatter": false,
